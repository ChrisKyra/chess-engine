<Project Sdk="Microsoft.NET.Sdk">

  <!-- A command-line match runner for engine testing. It compiles the GUI's ChessCore
       sources directly (rules, openings, clocks, SPRT, adjudication), so its results are
       the ones the Match tab would give. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>match-runner</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../gui/src/ChessCore/**/*.cs" Exclude="../../gui/src/ChessCore/bin/**;../../gui/src/ChessCore/obj/**" />
  </ItemGroup>

</Project>
